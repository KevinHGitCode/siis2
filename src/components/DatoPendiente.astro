---
interface Props {
  texto?: string;
}

const { texto = 'Por confirmar' } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 rounded-md border border-dashed border-slate-400 px-2 py-0.5 font-mono text-xs text-slate-600">
  <span class="h-1.5 w-1.5 rounded-full bg-wayuu-yellow" aria-hidden="true"></span>{texto}
</span>
