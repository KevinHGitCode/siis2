---
import '../styles/global.css';
import { SEMILLERO } from '../data/semillero';
import { INTEGRANTES } from '../data/integrantes';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SEMILLERO.nombreCorto} — ${SEMILLERO.nombreLargo}`,
  description = SEMILLERO.descripcionSEO,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: SEMILLERO.nombreLargo,
  alternateName: SEMILLERO.nombreCorto,
  url: canonical,
  foundingDate: SEMILLERO.fundacion,
  description: SEMILLERO.descripcionSEO,
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: SEMILLERO.universidad,
    url: SEMILLERO.universidadUrl,
  },
  member: INTEGRANTES.map((i) => ({ '@type': 'Person', name: i.nombre })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEMILLERO.nombreCorto} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased">
    <slot />
  </body>
</html>
