---
interface Props {
  id: string;
  titulo: string;
}

const { id, titulo } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-20 px-4 py-16">
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{titulo}</h2>
  <div class="mt-8"><slot /></div>
</section>
