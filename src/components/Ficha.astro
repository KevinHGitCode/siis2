---
import { SEMILLERO } from '../data/semillero';
import { PROYECTOS } from '../data/proyectos';
import { LOGROS } from '../data/logros';
import { formatearFecha, masReciente } from '../lib/fechas';
import DatoPendiente from './DatoPendiente.astro';

// Fecha más reciente de los datos cargados (no la del build): dice hasta cuándo está al día la información.
const actualizado = masReciente([...PROYECTOS.map((p) => p.fechaConfirmada), ...LOGROS.map((l) => l.fechaRegistro)]);

const datos = [
  { etiqueta: 'Universidad', valor: `${SEMILLERO.universidad}, sede ${SEMILLERO.sede}` },
  { etiqueta: 'Programa', valor: SEMILLERO.programa },
  { etiqueta: 'Docente líder', valor: SEMILLERO.docenteLider },
  { etiqueta: 'Fundado', valor: SEMILLERO.fundacion },
];
---

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
  {datos.map((d) => (
    <div class="revela rounded-xl border border-slate-200 bg-white p-4">
      <p class="font-mono text-xs text-slate-600">{d.etiqueta}</p>
      <p class="mt-1 text-sm font-semibold text-slate-900">{d.valor}</p>
    </div>
  ))}
  <div class="revela rounded-xl border border-dashed border-slate-400 p-4">
    <p class="font-mono text-xs text-slate-600">Grupo de investigación</p>
    <p class="mt-1.5">
      {SEMILLERO.grupoInvestigacion ? (
        <span class="text-sm font-semibold text-slate-900">{SEMILLERO.grupoInvestigacion}</span>
      ) : (
        <DatoPendiente />
      )}
    </p>
  </div>
</div>
<p class="mt-3 font-mono text-xs text-slate-600">Datos actualizados el {formatearFecha(actualizado)}</p>
