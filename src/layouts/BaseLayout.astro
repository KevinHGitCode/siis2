---
import '../styles/global.css';
import fuenteMarca from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import { SEMILLERO } from '../data/semillero';
import { ASSETS } from '../consts';
import { graph, schemaSemillero } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // Imagen 1200×630 para compartir (en /siis2/images/og/). Por defecto, la del semillero.
  ogImage?: string;
  ogAlt?: string;
  // Datos estructurados de la página (nodos de un @graph). Por defecto, el semillero.
  schema?: object[];
}

const {
  title = `${SEMILLERO.nombreCorto} — ${SEMILLERO.nombreLargo}`,
  description = SEMILLERO.descripcionSEO,
  noindex = false,
  ogImage = 'og-siis2.png',
  ogAlt = `${SEMILLERO.nombreCorto}, ${SEMILLERO.nombreLargo}, ${SEMILLERO.universidad}`,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imagenOg = new URL(`${base}${ASSETS}/images/og/${ogImage}`, Astro.site).href;
const jsonLd = graph(schema ?? [schemaSemillero(canonical)]);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}${ASSETS}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="48x48" href={`${base}${ASSETS}/favicon-48.png`} />
    <link rel="apple-touch-icon" href={`${base}${ASSETS}/apple-touch-icon.png`} />
    <link rel="preload" as="font" type="font/woff2" href={fuenteMarca} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SEMILLERO.nombreCorto} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagenOg} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased">
    <slot />
  </body>
</html>
