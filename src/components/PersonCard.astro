---
import type { Integrante } from '../data/integrantes';

const { integrante } = Astro.props as { integrante: Integrante };
const iniciales = integrante.nombre
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('');
---

<div class="flex flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center">
  {integrante.foto ? (
    <img src={integrante.foto} alt={integrante.nombre} class="h-20 w-20 rounded-full object-cover" />
  ) : (
    <div class="flex h-20 w-20 items-center justify-center rounded-full bg-brand-100 text-xl font-semibold text-brand-700">
      {iniciales}
    </div>
  )}
  <p class="mt-4 font-semibold text-slate-900">{integrante.nombre}</p>
  <p class="text-sm text-slate-500">{integrante.rol}</p>
</div>
