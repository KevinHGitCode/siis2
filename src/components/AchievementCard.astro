---
import type { Logro } from '../data/logros';

const { logro } = Astro.props as { logro: Logro };
---

<article class="rounded-2xl border border-slate-200 bg-white p-6">
  <h3 class="text-lg font-semibold text-slate-900">{logro.titulo}</h3>
  {logro.fecha && <p class="mt-1 text-sm text-slate-500">{logro.fecha}</p>}
  <p class="mt-3 text-sm text-slate-600">{logro.resumen}</p>
  {logro.href && (
    <a href={logro.href} class="mt-4 inline-block text-sm font-medium text-brand-700 hover:underline">
      Leer más →
    </a>
  )}
</article>
