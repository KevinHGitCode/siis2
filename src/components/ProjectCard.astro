---
import type { Proyecto } from '../data/proyectos';

const { proyecto } = Astro.props as { proyecto: Proyecto };
---

<a
  href={proyecto.href}
  class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand-100 hover:shadow-lg"
>
  <div class="flex items-center justify-between gap-3">
    <h3 class="text-lg font-semibold text-slate-900">{proyecto.nombre}</h3>
    <span class="shrink-0 rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
      {proyecto.estado}
    </span>
  </div>
  <p class="mt-1 text-sm text-slate-500">«{proyecto.alias}»</p>
  <p class="mt-3 flex-1 text-sm text-slate-600">{proyecto.descripcion}</p>
  <span class="mt-4 text-sm font-medium text-brand-700 group-hover:underline">Ver proyecto →</span>
</a>
