---
import { Picture } from 'astro:assets';
import type { Integrante } from '../data/integrantes';
import { fotoEquipo } from '../lib/fotos';

interface Props {
  integrante: Integrante;
  indice?: number;
}

const { integrante, indice = 0 } = Astro.props;
const foto = fotoEquipo(integrante.foto);
const iniciales = integrante.nombre
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('');

// Colores del logo; el texto de cada avatar se eligió para pasar AA (teal y amarillo llevan tinta oscura).
const estilos = [
  'bg-wayuu-teal text-slate-900',
  'bg-wayuu-red text-white',
  'bg-wayuu-yellow text-slate-900',
  'bg-brand-700 text-white',
];
---

<div class:list={['revela overflow-hidden rounded-2xl border border-slate-200 bg-white', !foto && 'flex items-center gap-3 p-4']}>
  {foto ? (
    <Picture
      src={foto}
      formats={['avif']}
      fallbackFormat="jpg"
      widths={[240, 360, 480]}
      sizes="(min-width: 1024px) 240px, (min-width: 640px) 45vw, 90vw"
      alt={`${integrante.nombre}, ${integrante.rol.toLowerCase()} del semillero SIIS2`}
      class="aspect-[4/5] w-full object-cover"
    />
  ) : (
    <div
      class:list={[
        'flex h-12 w-12 shrink-0 items-center justify-center rounded-full font-marca text-base font-extrabold',
        estilos[indice % estilos.length],
      ]}
      aria-hidden="true"
    >
      {iniciales}
    </div>
  )}
  <div class:list={[foto && 'p-4']}>
    <p class="font-semibold text-slate-900">{integrante.nombre}</p>
    <p class="text-sm text-slate-600">{integrante.rol}</p>
  </div>
</div>
