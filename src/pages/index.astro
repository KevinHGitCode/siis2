---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SEMILLERO } from '../data/semillero';
import { PROYECTOS } from '../data/proyectos';

const title = 'Desarrollo Uniguajira Maicao — proyectos de software de la Universidad de La Guajira';
const description =
  'Portal de proyectos de software desarrollados en la sede Maicao de la Universidad de La Guajira: el semillero SIIS2 y sus aplicaciones.';

// Directorio de lo que vive en este dominio. Cada entrada es una apuesta de la red:
// enlaza hacia su propia página (con su propio SEO) y esa página enlaza de vuelta aquí.
const destinos = [
  {
    nombre: SEMILLERO.nombreCorto,
    titulo: SEMILLERO.nombreLargo,
    descripcion: SEMILLERO.descripcionCorta,
    href: '/siis2',
    etiqueta: 'Semillero de investigación',
  },
  ...PROYECTOS.map((p) => ({
    nombre: p.nombre,
    titulo: `${p.nombre} — «${p.alias}»`,
    descripcion: p.descripcion,
    href: p.href,
    etiqueta: p.estado,
  })),
];
---

<BaseLayout title={title} description={description}>
  <header class="border-b border-slate-200">
    <div class="mx-auto max-w-5xl px-4 py-4">
      <span class="font-bold tracking-tight text-slate-900">Desarrollo Uniguajira Maicao</span>
    </div>
  </header>

  <section class="mx-auto max-w-5xl px-4 pb-8 pt-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">
      Universidad de La Guajira · Sede Maicao
    </p>
    <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
      Proyectos de software hechos en Maicao
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
      Software construido por estudiantes de Ingeniería de Sistemas de la sede Maicao: el semillero
      de investigación {SEMILLERO.nombreCorto} y las aplicaciones que ha impulsado.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-24">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destinos.map((d) => (
        <a
          href={d.href}
          class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-brand-100 hover:shadow-lg"
        >
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-slate-900">{d.nombre}</h2>
            <span class="shrink-0 rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
              {d.etiqueta}
            </span>
          </div>
          <p class="mt-1 text-sm text-slate-500">{d.titulo}</p>
          <p class="mt-3 flex-1 text-sm text-slate-600">{d.descripcion}</p>
          <span class="mt-4 text-sm font-medium text-brand-700 group-hover:underline">Ver →</span>
        </a>
      ))}
    </div>
  </section>

  <footer class="border-t border-slate-200 bg-slate-50 py-6 text-center text-xs text-slate-500">
    © {new Date().getFullYear()} {SEMILLERO.universidad} — Sede Maicao
  </footer>
</BaseLayout>
