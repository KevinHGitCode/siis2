---
interface Props {
  fina?: boolean;
  // Borde recto abajo (la banda "sube"): remate de un bloque. Por defecto el borde recto va arriba (la banda "cuelga").
  arriba?: boolean;
}

const { fina = false, arriba = false } = Astro.props;
---

<div class:list={['banda-wayuu', fina && 'banda-wayuu-fina', arriba && 'banda-wayuu-arriba']} aria-hidden="true"></div>
