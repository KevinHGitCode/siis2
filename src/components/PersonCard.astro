---
import type { Integrante } from '../data/integrantes';

interface Props {
  integrante: Integrante;
  indice?: number;
}

const { integrante, indice = 0 } = Astro.props;
const iniciales = integrante.nombre
  .split(' ')
  .map((n) => n[0])
  .slice(0, 2)
  .join('');

// Colores del logo; el texto de cada avatar se eligió para pasar AA (teal y amarillo llevan tinta oscura).
const estilos = [
  'bg-wayuu-teal text-slate-900',
  'bg-wayuu-red text-white',
  'bg-wayuu-yellow text-slate-900',
  'bg-brand-700 text-white',
];
---

<div class="revela flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4">
  {integrante.foto ? (
    <img src={integrante.foto} alt={integrante.nombre} class="h-12 w-12 shrink-0 rounded-full object-cover" />
  ) : (
    <div
      class:list={[
        'flex h-12 w-12 shrink-0 items-center justify-center rounded-full font-marca text-base font-extrabold',
        estilos[indice % estilos.length],
      ]}
      aria-hidden="true"
    >
      {iniciales}
    </div>
  )}
  <div>
    <p class="font-semibold text-slate-900">{integrante.nombre}</p>
    <p class="text-sm text-slate-600">{integrante.rol}</p>
  </div>
</div>
